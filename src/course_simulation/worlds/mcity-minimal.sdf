<?xml version="1.0"?>
<sdf version="1.9">
  <world name="mcity_minimal">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <!-- a few blocks so camera and lidar see something -->
    <model name="block_north"><static>true</static><pose>4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 3 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.5 3 1</size></box></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material></visual>
      </link></model>
    <model name="block_west"><static>true</static><pose>0 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3 0.5 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 0.5 1</size></box></geometry>
          <material><diffuse>0.2 0.8 0.2 1</diffuse></material></visual>
      </link></model>
    <model name="block_east"><static>true</static><pose>0 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3 0.5 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3 0.5 1</size></box></geometry>
          <material><diffuse>0.2 0.2 0.8 1</diffuse></material></visual>
      </link></model>

    <include>
      <uri>model://course_ackermann</uri>
      <name>course_ackermann</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
